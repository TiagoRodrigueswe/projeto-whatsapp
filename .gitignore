## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015 cache/options directory
.vs/
# Visual Studio 2017 cache/options directory
.vsconfig

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
[Uu]nicode [Dd]ebugPS/
[Uu]nicode [Rr]eleasePS/

# Visual Studio 2019 cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
[Tt]est[Rr]esult.xml
nunit-*.xml

# Build Results of managed Web Application Projects
_WebApp[Pp]ublish/
# Build Results of managed Web Application Projects from VS2019
_GeneratedWebConfig/

# Visual Studio Code files for C#
.vscode/

# Mac files
.DS_Store

# Windows files
Thumbs.db

# Rider files
.idea/

# Backup and recover files
*.bak
*.tmp

# NuGet packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if you don't want to check in analytics files
# NuGet.VisualStudio.Interop.dll
# NuGet.VisualStudio.Interop.pdb
# NetStandard, .NET Core
obj/
bin/
# Added for .NET Core
/test/**/obj/
/test/**/bin/
# Rider Code Analysis
*.DotSettings.user
# Ignore files specific to Visual Studio code coverage
*.coverage
*.coveragexml

# CMake
CMake*.txt
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CTestTestfile.cmake
cmake_install.cmake
install_manifest.txt
project_options.cmake
CTestConfig.cmake

# Dotnet files
project.lock.json
project.fragment.lock.json
artifacts/
**/Properties/launchSettings.json
*.csproj.user
*.generated.props
*.generated.targets

# My specific ignores
ProjectManagement.Solution/
